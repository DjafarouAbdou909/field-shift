[Unit]
Description=AgriBot, application Streamlit des conseillers
After=network-online.target
Wants=network-online.target

[Service]
User=agribot
Group=agribot
WorkingDirectory=/opt/agribot
EnvironmentFile=/opt/agribot/.env
ExecStart=/opt/agribot/venv/bin/streamlit run app/app.py --server.port 8501 --server.address 127.0.0.1 --server.headless true --browser.gatherUsageStats false
Restart=always
RestartSec=5
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full

[Install]
WantedBy=multi-user.target
