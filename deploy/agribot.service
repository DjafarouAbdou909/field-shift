[Unit]
Description=AgriBot, webhook WhatsApp
After=network-online.target
Wants=network-online.target

[Service]
User=agribot
Group=agribot
WorkingDirectory=/opt/agribot
EnvironmentFile=/opt/agribot/.env
# Un seul processus, les sessions SQLite et les caches de voix étant partagés en mémoire.
ExecStart=/opt/agribot/venv/bin/uvicorn bot.main:app --host 127.0.0.1 --port 8000 --no-access-log --log-level info
Restart=always
RestartSec=5
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full

[Install]
WantedBy=multi-user.target
