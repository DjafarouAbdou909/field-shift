# Copier en .env et remplir. Ne jamais versionner .env.
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_APP_SECRET=
# Jeton d'utilisateur système, le jeton temporaire expire en 24 heures environ
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
SEL_NUMEROS=
BASE_DE_DONNEES=data/bot.sqlite3
URL_APPLICATION=http://localhost:8501
# Clé de l'API Gemini pour le diagnostic par photo, projet au niveau payant obligatoire
GEMINI_API_KEY=
# Clé de l'API Aethex pour la transcription des notes vocales et la synthèse vocale
AETHEX_API_KEY=
# Facultatif, identifiant d'une voix Aethex, sinon une voix française de Côte d'Ivoire est cherchée
AETHEX_VOICE_ID=
# Clé de l'API Groq, transcription, compréhension et réponses écrites
GROQ_API_KEY=
# Facultatif, Gemini par Agent Platform de Google Cloud, prioritaire sur GEMINI_API_KEY si les deux sont remplis
AGENT_PLATFORM_PROJET=
AGENT_PLATFORM_API_KEY=
# Facultatif, plafond quotidien de caractères envoyés à Aethex, 8000 par défaut
AETHEX_CARACTERES_PAR_JOUR=
# Facultatif, adresse de la plateforme hors connexion envoyée à l'agriculteur
PLATEFORME_URL=

# Carte du champ par satellite, jeton NASA Earthdata créé sur https://urs.earthdata.nasa.gov, menu Generate Token.
# Sans lui, le compte de ~/.netrc sert, et sans les deux la carte du champ répond qu'elle est indisponible.
EARTHDATA_TOKEN=
