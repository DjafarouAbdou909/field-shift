# Copier en .env et remplir. Ne jamais versionner .env.
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_APP_SECRET=
# Jeton d'utilisateur système, le jeton temporaire expire en 24 heures environ
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
SEL_NUMEROS=
BASE_DE_DONNEES=data/bot.sqlite3
URL_APPLICATION=http://localhost:8501
# Clé de l'API Gemini pour le diagnostic par photo, projet au niveau payant obligatoire
GEMINI_API_KEY=
# Clé de l'API Aethex pour la transcription des notes vocales et la synthèse vocale
AETHEX_API_KEY=
# Facultatif, identifiant d'une voix Aethex, sinon une voix française de Côte d'Ivoire est cherchée
AETHEX_VOICE_ID=
# Facultatif, clé de l'API Grok de xAI, payante, réponses de secours quand Gemini n'a plus de quota
XAI_API_KEY=
